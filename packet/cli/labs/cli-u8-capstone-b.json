    {
      "id": "trace",
      "text": "From PC1, run tracert to PC3 and confirm the path goes through both R1 and R2.",
      "check": {
        "type": "commandUsed",
        "device": "PC1",
        "re": "^tracert \\S+$"
      }
    },
    {
      "id": "save",
      "text": "Save all three routers.",
      "checks": [
        {
          "type": "saved",
          "device": "R1"
        },
        {
          "type": "saved",
          "device": "R2"
        },
        {
          "type": "saved",
          "device": "R3"
        }
      ]
    }
  ],
  "extension": "Replace R2's two static routes with a single summary route covering both LANs, and say what you gave up by doing it. Then break exactly one thing and hand the topology to a teammate.",
  "debrief": "The shape is the lesson. Stub routers at the edges want a default; a router in the middle wants specifics, because a default there has nowhere honest to point. When PC1 reaches the server but not PC3, you already know which of R2's two routes is missing without looking.\n\nSame after-action review as Capstone A: knowledge, speed, process. Two clean runs on two different topologies is the U8 gate — this is the second one.",
  "solution": [
    {
      "device": "R1",
      "cmds": [
        "enable",
        "configure terminal",
        "interface g0/0",
        "ip address 10.10.1.1 255.255.255.0",
        "no shutdown",
        "interface g0/1",
        "ip address 10.10.100.1 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 0.0.0.0 0.0.0.0 10.10.100.2",
        "end",
        "copy running-config startup-config",
        ""
      ]
    },
    {
      "device": "R2",
      "cmds": [
        "enable",
        "configure terminal",
        "interface g0/0/0",
        "ip address 10.10.100.2 255.255.255.252",
        "no shutdown",
        "interface g0/0/1",
        "ip address 10.10.200.1 255.255.255.252",
        "no shutdown",
        "interface g0/0/2",
        "ip address 10.10.2.1 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 10.10.1.0 255.255.255.0 10.10.100.1",
        "ip route 10.10.3.0 255.255.255.0 10.10.200.2",
        "end",
        "copy running-config startup-config",
        ""
      ]
    },
    {
      "device": "R3",
      "cmds": [
        "enable",
        "configure terminal",
        "interface g0/0",
        "ip address 10.10.200.2 255.255.255.252",
        "no shutdown",
        "interface g0/1",
        "ip address 10.10.3.1 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 0.0.0.0 0.0.0.0 10.10.200.1",
        "ip dhcp excluded-address 10.10.3.1 10.10.3.9",
        "ip dhcp pool LAN3",
        "network 10.10.3.0 255.255.255.0",
        "default-router 10.10.3.1",
        "dns-server 10.10.2.10",
        "end",
        "copy running-config startup-config",
        ""
      ]
    },
    {
      "device": "PC1",
      "cmds": [
        "ipconfig",
        "__static:10.10.1.10/24/10.10.1.1__",
        "__setdns:10.10.2.10__"
      ]
    },
    {
      "device": "PC3",
      "cmds": [
        "__dhcp__",
        "ipconfig /all"
      ]
    },
    {
      "device": "PC1",
      "cmds": [
        "ping 10.10.2.10",
        "ping 10.10.3.10",
        "tracert 10.10.3.10"
      ]
    },
    {
      "device": "PC3",
      "cmds": [
        "ping 10.10.2.10"
      ]
    }
  ]
}
